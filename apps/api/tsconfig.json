{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "paths": {
      "@wallet-web-app/database": [
        "../../packages/database/src"
      ],
      "@wallet-web-app/types": [
        "../../packages/types/src"
      ],
      "@wallet-web-app/config": [
        "../../packages/config/src"
      ]
    }
  }
}